#!/usr/bin/env python3
# Code Hub from a checkout or a USB stick, without installing a package:
# puts the folder above bin/ on the import path and starts the command line.
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from codehub.cli import main  # noqa: E402

sys.exit(main())
